# Secrets for the coach. Keep this file chmod 600 and out of every git repo.
# Cron does not read your shell profile; the scripts source this explicitly.

# Absolute path to claude - cron's PATH is minimal.
export CLAUDE_BIN="$HOME/.local/bin/claude"

# Telegram (integrations.telegram). The bot token itself lives with the
# Telegram plugin in ~/.claude/channels/telegram/.env, not here.
# Find the chat id: message your bot, then open
#   https://api.telegram.org/bot<TOKEN>/getUpdates  and read message.chat.id
export TELEGRAM_CHAT_ID=""

# Apple Health receiver (integrations.apple_health). Generate with:
#   openssl rand -hex 16
# and put the same value in the Health Auto Export x-api-key header.
export HEALTH_API_KEY=""
# export HEALTH_PORT="5556"
